# ── Accounts + email verification (Supabase) ─────────────────────────────────
# Leave these unset to run the app in guest-only mode (no login required).
# To enable real accounts with email verification:
#   1. Create a free project at https://supabase.com
#   2. Project Settings → API → copy the Project URL and the anon/public key
#   3. Copy this file to `.env` and paste them below
#   4. In Supabase → Authentication → Providers → Email, keep "Confirm email" ON
#   5. Add your deployed site URL under Authentication → URL Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Analytics (PostHog) — optional ───────────────────────────────────────────
# Leave unset and the app tracks NOTHING and loads no analytics code. To switch on
# full product analytics (funnels, retention, session replay + every event already
# wired via track()):
#   1. Create a free project at https://posthog.com
#   2. Project Settings → copy the "Project API Key" (starts with phc_ — it's public,
#      safe to ship in the client) and your region's host (US: https://us.i.posthog.com,
#      EU: https://eu.i.posthog.com)
#   3. Paste below, then redeploy. Everything lights up automatically.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
