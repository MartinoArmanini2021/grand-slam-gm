{
  "name": "grand-slam-gm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "reconcile:field": "node scripts/reconcile-field.mjs",
    "verify:app": "node scripts/verify-app.mjs",
    "gen:avatars": "node scripts/generate-avatars.mjs",
    "dev:cincinnati": "vite --mode cincinnati",
    "field:build": "node scripts/build-field.mjs",
    "field:seed": "node scripts/gen-seed.mjs",
    "dev:montreal": "vite --mode montreal",
    "deploy:ux": "node scripts/deploy.mjs branch=ux-revamp"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/urbanist": "^5.2.7",
    "@supabase/supabase-js": "^2.110.7",
    "posthog-js": "^1.407.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "jimp": "^0.22.12",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {}
